# Endpoint base do Ollama local
AXEL_OLLAMA_BASE_URL=http://localhost:11434

# Modelo de texto usado para planejamento, conversa e interpretação de comandos
AXEL_OLLAMA_TEXT_MODEL=qwen2.5:0.5b

# Modelo visual opcional do Ollama
AXEL_OLLAMA_VISION_MODEL=llama3.2-vision:11b

# Chave opcional do Gemini para perguntas mais complexas
AXEL_GEMINI_API_KEY=

# Modelo do Gemini usado nas perguntas complexas
AXEL_GEMINI_MODEL=gemini-2.5-flash

# Modelo de voz/TTS do Gemini para testes de audio
AXEL_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Se 1, o Gemini vira o principal para todas as chamadas de texto, com fallback para Ollama
AXEL_GEMINI_PRIMARY_TEXT_ENABLED=1

# Se 1, o Gemini entra apenas em perguntas mais complexas de conversa
AXEL_GEMINI_COMPLEX_CHAT_ENABLED=1

# URL REST do seu projeto Supabase
AXEL_SUPABASE_REST_URL=

# Chave publishable do projeto Supabase
AXEL_SUPABASE_PUBLISHABLE_KEY=

# Chave anon do projeto Supabase
AXEL_SUPABASE_ANON_KEY=

# Tabela usada para sincronizar memorias simples do Axel
AXEL_SUPABASE_MEMORY_TABLE=axel_memory_states

# Se 1, ativa sincronizacao opcional com Supabase
AXEL_SUPABASE_SYNC_ENABLED=1

# Caminho opcional para seu vault do Obsidian
# Se ficar vazio, o Axel usa memory/obsidian_vault localmente
AXEL_OBSIDIAN_VAULT_PATH=

# Se 1, espelha memorias importantes em notas Markdown estilo Obsidian
AXEL_OBSIDIAN_SYNC_ENABLED=1

# Link direto da sua carteira no Investidor10
# Pode ser privada/autenticada ou pública.
# Exemplo público:
# AXEL_INVESTIDOR10_WALLET_URL=https://investidor10.com.br/wallet/public/SEU_ID
AXEL_INVESTIDOR10_WALLET_URL=

# URL privada usada quando você quer aproveitar sua sessão logada do Edge
AXEL_INVESTIDOR10_PRIVATE_WALLET_URL=https://investidor10.com.br/wallet/my-wallet

# Perfil do Edge usado para tentar ler a carteira privada com a sua sessão
AXEL_EDGE_USER_DATA_DIR=
AXEL_EDGE_PROFILE_DIRECTORY=Default

# Leitura automatica da carteira privada com Playwright.
# Opcional: use um perfil dedicado para o Axel e faca login nele uma vez.
AXEL_WALLET_PLAYWRIGHT_ENABLED=1
AXEL_WALLET_PLAYWRIGHT_CHANNEL=msedge
AXEL_WALLET_PLAYWRIGHT_USER_DATA_DIR=

# Token opcional da BRAPI para ampliar cobertura de cotação e fundamentos por ticker
AXEL_BRAPI_TOKEN=

# Se 1, Axel tenta usar BRAPI antes do fallback atual
AXEL_BRAPI_ENABLED=1

# Chave opcional da NewsAPI para notícias por ativo
AXEL_NEWSAPI_KEY=

# Se 1, Axel tenta usar NewsAPI nas notícias e fatos relevantes de ativos
AXEL_NEWSAPI_ENABLED=1

# Spotify API: melhora bastante a busca por música antes de abrir/tocar
AXEL_SPOTIFY_API_ENABLED=1
AXEL_SPOTIFY_CLIENT_ID=
AXEL_SPOTIFY_CLIENT_SECRET=
AXEL_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Opcional: se você tiver token de usuário com escopo user-modify-playback-state
# o Axel também consegue mandar tocar de verdade via API, não só abrir a faixa
AXEL_SPOTIFY_ACCESS_TOKEN=
AXEL_SPOTIFY_REFRESH_TOKEN=
AXEL_SPOTIFY_DEVICE_ID=
