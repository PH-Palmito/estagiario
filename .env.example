# Endpoint base do Ollama local
AXEL_OLLAMA_BASE_URL=http://localhost:11434

# Modelo de texto usado para planejamento, conversa e interpretação de comandos
AXEL_OLLAMA_TEXT_MODEL=qwen2.5:0.5b

# Modelo visual opcional do Ollama
AXEL_OLLAMA_VISION_MODEL=llama3.2-vision:11b

# Link direto da sua carteira no Investidor10
# Exemplo:
# AXEL_INVESTIDOR10_WALLET_URL=https://investidor10.com.br/wallet/my-wallet/SEU_ID
AXEL_INVESTIDOR10_WALLET_URL=
